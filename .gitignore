# Ignore the executable files
*.exe

# Ignore compiled object files and binaries
*.o
*.out
*.a
*.so
*.dll

# Ignore the module download cache and build artifacts
bin/
build/
vendor/
.idea/
.vscode/
*.log

# Ignore Go package files
*.test
*.prof
*.coverprofile
*.tmp

# Ignore dependency files that can be restored
go.sum

# Ignore images or other large media files if necessary (customize for your use case)
# Example:
# images/*.png
# images/*.jpg

# Ignore user-specific settings and metadata
.DS_Store
*.swp
*.swo

# Ignore backup files
*~
*.bak
*.old
*.orig
*.rej

# Ignore temporary and hidden system files
Thumbs.db
Desktop.ini
